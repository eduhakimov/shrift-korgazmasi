/* Shrift ko'rgazmasi: tekis, tipografik, keskinroq burchaklar */
QFrame#Card { border-radius: 6px; }
QFrame#Toolbar { background: {surface}; border: 1px solid {border}; border-radius: 6px; }
QLabel#AppTitle { font-size: 15pt; font-weight: 600; letter-spacing: 0.3px; }
QPushButton { border-radius: 4px; padding: 6px 12px; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit { border-radius: 4px; }
QTabBar#Segment { background: {surface2}; border: 1px solid {border}; border-radius: 6px; }
QTabBar#Segment::tab { background: transparent; color: {muted}; padding: 6px 16px; margin: 3px;
    border: none; border-radius: 4px; min-width: 90px; font-weight: 600; }
QTabBar#Segment::tab:selected { background: {surface}; color: {text}; font-weight: 600; border: 1px solid {border}; }
QTabBar#Segment::tab:hover:!selected { color: {text}; }
QListView { border-radius: 6px; }
